{
  "name": "scheduleboard",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix suke install",
    "dev": "concurrently -n server,client -c auto \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix suke run dev",
    "build": "npm --prefix suke run build",
    "start": "npm --prefix server run start",
    "inspect:dist": "node tools/inspect-dist.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

